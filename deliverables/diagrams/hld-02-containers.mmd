flowchart TB
    subgraph clients["Clients"]
        opsui["Ops Console<br/><i>Filament admin</i>"]
        vendorui["Vendor Portal<br/><i>Filament panel</i>"]
        custui["Customer Returns Portal<br/><i>Phase 1b - public, no login</i>"]
        adminui["<b>Super Admin Console</b><br/><i>integrations, users, rules, health</i>"]
    end

    subgraph app["Application Tier"]
        web["Web / API<br/><i>Laravel 11 - HTTP, auth, RBAC</i>"]
        webhook["Webhook Receiver<br/><i>signature verify, fast 200,<br/>persist to inbox</i>"]
        worker["Queue Workers<br/><i>Horizon - integration,<br/>finance, notification queues</i>"]
        sched["Scheduler<br/><i>reconciliation, settlement runs,<br/>SLA breach sweeps</i>"]
    end

    subgraph domain["Domain Modules"]
        orders["Order &amp; Item Splitting"]
        shipping["Shipping / AWB"]
        returns["<b>Returns &amp; Exchanges</b><br/><i>in-house - replaces E-stebdal</i>"]
        finance["Financial Engine<br/><i>snapshots, ledger</i>"]
        inventory["Inventory + Raw Fabric BOM"]
        vendors["Vendor Mgmt &amp; Settlement"]
        audit["Audit Trail"]
        config["<b>Configuration</b><br/><i>settings, RBAC, credentials,<br/>report definitions</i>"]
    end

    subgraph data["Data Tier"]
        pg[("PostgreSQL 16<br/><i>OLTP + reporting replica</i>")]
        redis[("Redis<br/><i>queues, cache, locks</i>")]
        s3[("Object Storage<br/><i>AWB PDFs, payout proofs</i>")]
    end

    subgraph adapters["Integration Adapters"]
        a1["Shopify Adapter"]
        a2["Bosta Adapter"]
        a3["Paymob Adapter"]
        a4["Courier Adapter<br/><i>Phase 2</i>"]
    end

    opsui --> web
    vendorui --> web
    custui --> web
    adminui --> web

    web --> domain
    webhook --> pg
    webhook --> redis
    worker --> domain
    sched --> worker

    domain --> pg
    domain --> redis
    domain --> s3
    domain --> adapters

    a1 <--> shopify["Shopify"]
    a2 <--> bosta["Bosta"]
    a3 <--> paymob["Paymob"]

    shopify -.->|webhooks| webhook
    bosta -.->|webhooks| webhook
    paymob -.->|HMAC callbacks| webhook

    classDef mod fill:#eef2ff,stroke:#6366f1,color:#1e293b
    classDef store fill:#ecfdf5,stroke:#10b981,color:#064e3b
    classDef ext fill:#f1f5f9,stroke:#94a3b8,color:#1e293b
    classDef hot fill:#fef3c7,stroke:#f59e0b,color:#78350f,stroke-width:2px

    class orders,shipping,finance,inventory,vendors,audit,web,worker,sched,a1,a2,a3,a4 mod
    class returns,config hot
    class pg,redis,s3 store
    class shopify,bosta,paymob ext
