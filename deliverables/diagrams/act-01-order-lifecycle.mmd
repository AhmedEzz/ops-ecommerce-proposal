%%{init: {'theme':'base','themeVariables':{'primaryColor':'#eef2ff','primaryTextColor':'#1e293b','primaryBorderColor':'#6366f1','lineColor':'#64748b','fontFamily':'Inter, Segoe UI, sans-serif','fontSize':'13px'}}}%%
flowchart TB
    start([Order placed on Shopify]) --> split["Split into ORDER_ITEMS<br/>1000-1, 1000-2, 1000-3<br/><i>one row per vendor/item</i>"]
    split --> new["Item status: <b>New</b>"]
    new --> csr{"CS review"}

    csr -->|"customer cancels"| c1["<b>Cancelled</b><br/><i>by customer</i>"]
    csr -->|confirmed| conf["<b>Confirmed (CS)</b>"]

    conf --> stock{"Vendor stock<br/>available?"}

    stock -->|no| oos["<b>Cancelled - OOS</b><br/><i>by Vendor / Ops</i>"]
    oos --> pen1["Evaluate vendor penalty<br/><i>409 OOS rows in 7 months</i>"]

    stock -->|yes| rts["<b>Ready-To-Ship</b><br/><i>by Vendor</i>"]
    rts --> awb["Create item-level AWB<br/><i>per item, not per order</i>"]
    awb --> ship["<b>Shipped (3PL)</b>"]
    ship --> tr{"3PL outcome"}

    tr -->|delivered| del["<b>Delivered</b><br/><i>49.3% of items</i>"]
    tr -->|"failed delivery"| fd["<b>Failed Delivery</b><br/><i>FD Allow Open Shipment</i><br/><i>3,743 items</i>"]
    tr -->|"refused / no answer"| rto["<b>RTO</b><br/><i>2,359 items</i>"]

    fd --> recall{"Recovery attempt<br/><i>Recall workflow</i>"}
    recall -->|"messaged, customer responds"| retry["Re-attempt delivery"]
    recall -->|"no response"| rto
    recall -->|"new order created"| newo["New order raised<br/><i>273 recovered in sheet</i>"]
    retry --> tr

    del --> revenue["Recognise revenue<br/>Post SALE + COMMISSION<br/>to vendor ledger"]
    rto --> reverse1["Reverse any accrual<br/>Return stock to inventory"]

    revenue --> post{"Post-delivery<br/>customer action?"}
    post -->|none| closed([Item closed - settled])
    post -->|"return request"| rr["<b>Return Request</b><br/><i>see return workflow</i>"]
    post -->|"exchange request"| er["<b>Exchange Request</b><br/><i>see exchange workflow</i>"]

    rr --> rflow(["Scenario 3<br/>Confirm Return (CS) -> Ready-To-Pick<br/>-> Under Return (3PL) -> Returned (WH)"])
    er --> eflow(["Scenario 4<br/>Confirm Exchange (CS) -> Ready-To-Pick<br/>-> Under Return (3PL) -> Returned (WH)"])

    rflow --> reverse2["Post RETURN_REVERSAL<br/>Create refund obligation"]
    eflow --> subst["Substitute fulfilment<br/>Carry original snapshot"]

    reverse2 --> closed
    subst --> closed
    c1 --> closed
    pen1 --> closed
    reverse1 --> closed
    newo --> closed

    classDef good fill:#ecfdf5,stroke:#10b981,color:#064e3b
    classDef bad fill:#fef2f2,stroke:#ef4444,color:#7f1d1d
    classDef warn fill:#fffbeb,stroke:#f59e0b,color:#78350f
    classDef norm fill:#eef2ff,stroke:#6366f1,color:#1e293b

    class del,revenue,closed,newo,retry good
    class rto,c1,oos,reverse1 bad
    class fd,recall,pen1 warn
    class new,conf,rts,awb,ship,split,rr,er,rflow,eflow,reverse2,subst norm
