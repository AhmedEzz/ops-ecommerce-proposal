        vendor["Vendor (82 active)<br/><i>stock, prices, payouts</i>"]
        customer["Customer<br/><i>returns &amp; exchanges - Phase 1b</i>"]
        exec["Management<br/><i>P&amp;L, performance</i>"]
    end

    ops --> OPS
    qc --> OPS
    vendor --> OPS
    customer --> OPS
    exec --> OPS

    OPS["<b>OPS Management System</b><br/>Item-level operations, financial engine,<br/>in-house returns, vendor portal<br/><i>System of record for operations</i>"]

    subgraph ext["External Systems"]
        shopify["Shopify<br/><i>storefront, orders, catalogue</i>"]
        bosta["Bosta 3PL<br/><i>forward + reverse shipping</i>"]
        paymob["Paymob<br/><i>payments + Send payouts</i>"]
        courier2["2nd Courier<br/><i>Phase 2</i>"]
        email["Email / WhatsApp<br/><i>AWB PDFs, notifications</i>"]
    end

    OPS <-->|"webhooks + Admin API<br/>orders, returns, refunds"| shopify
    OPS <-->|"REST + webhooks<br/>per-item AWB, tracking"| bosta
    OPS <-->|"HMAC callbacks<br/>+ Paymob Send"| paymob
    OPS -.->|"Phase 2 adapter"| courier2
    OPS -->|"labels, payout proofs"| email

    retired["Istibdal / E-stebdal<br/><b>RETIRED</b> - replaced by<br/>in-house Returns module"]
    OPS -.->|"parallel run until Jan,<br/>then decommissioned"| retired

    classDef sys fill:#4f46e5,stroke:#3730a3,color:#ffffff,stroke-width:2px
