        end

        obj[("Object Storage<br/><i>AWB PDFs, payout proofs</i>")]
    end

    lb --> php
    php --> pg
    php --> rd
    php --> obj
    hz --> pg
    hz --> rd
    hz --> obj
    cron --> rd

    subgraph obs["Observability - free tiers"]
        sentry["Sentry<br/><i>errors</i>"]
